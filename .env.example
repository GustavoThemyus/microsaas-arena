# Copie para .env e preencha. NUNCA commite o .env. Nenhum valor real neste arquivo.

# --- Banco (local: docker compose up -d, porta 5434) ---
DATABASE_URL=jdbc:postgresql://localhost:5434/cobranca
DB_USER=cobranca
DB_PASSWORD=cobranca

# --- API ---
PORT=8080
# Origem do front permitida no CORS (em produção: URL da Vercel)
ALLOWED_ORIGIN=http://localhost:3000
# Token do "link de demo". Vazio = API aberta (só para desenvolvimento local!)
DEMO_TOKEN=
# WhatsApp usado nos alunos fictícios, formato 55 + DDD + número (padrão: número fictício)
DEMO_WHATSAPP=5583900000000

# --- Asaas SANDBOX (entrega 2) ---
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
# Token que VOCÊ inventa e cadastra no webhook do Asaas (não pode ser a API key)
ASAAS_WEBHOOK_TOKEN=

# --- Front (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8080
